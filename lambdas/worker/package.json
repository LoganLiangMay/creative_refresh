{
  "name": "rda-worker-lambda",
  "version": "1.0.0",
  "description": "Worker Lambda for RDA Image Generation - Processes SQS messages and generates images",
  "main": "index.js",
  "scripts": {
    "test": "MOCK_MODE=true jest --coverage",
    "test:watch": "MOCK_MODE=true jest --watch"
  },
  "dependencies": {
    "aws-sdk": "^2.1497.0",
    "sharp": "^0.33.0",
    "axios": "^1.6.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "@types/jest": "^29.5.8",
    "aws-sdk-mock": "^5.8.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "index.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testTimeout": 30000
  }
}