{
  "name": "rda-prompt-builder-lambda",
  "version": "1.0.0",
  "description": "Prompt Builder Lambda for RDA Image Generation - Analyzes prompts and generates refined prompts",
  "main": "index.js",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "aws-sdk": "^2.1497.0",
    "openai": "^7.12.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "aws-sdk-mock": "^6.2.2",
    "jest": "^30.5.1"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "index.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(uuid)/)"
    ]
  }
}
