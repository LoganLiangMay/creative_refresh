{
  "name": "rda-controller-lambda",
  "version": "1.0.0",
  "description": "Controller Lambda for RDA Image Generation - Handles API endpoints",
  "main": "index.js",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "aws-sdk": "^2.1497.0",
    "axios": "^1.20.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "aws-sdk-mock": "^6.2.2",
    "jest": "^30.5.1"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "index.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 59,
        "functions": 50,
        "lines": 65,
        "statements": 65
      }
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(uuid)/)"
    ]
  }
}
